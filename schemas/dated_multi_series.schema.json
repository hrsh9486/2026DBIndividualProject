{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/dated_multi_series.schema.json",
  "title": "Dated Multi-Series Indicator",
  "description": "One chart-ready JSON object containing one or more dated series, including monthly, quarterly, daily and fiscal-year data.",
  "type": "object",
  "required": [
    "metadata",
    "series"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "generated_at",
        "source",
        "frequency",
        "start_date",
        "end_date",
        "indicator_code",
        "label",
        "default_unit",
        "series_order",
        "is_derived"
      ],
      "additionalProperties": true,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annual",
            "mixed"
          ]
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "indicator_code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "default_unit": {
          "type": "string",
          "minLength": 1
        },
        "series_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "is_derived": {
          "type": "boolean"
        },
        "methodology": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "series": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/series"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "series": {
      "type": "object",
      "required": [
        "label",
        "entity",
        "unit",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "date",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "period_label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "actual",
            "provisional",
            "revised",
            "estimate",
            "budget"
          ]
        }
      }
    }
  }
}
