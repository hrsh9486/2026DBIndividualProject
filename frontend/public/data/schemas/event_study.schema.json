{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/event_study.schema.json",
  "title": "Named Event Study Bundle",
  "type": "object",
  "required": ["metadata", "events"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["generated_at", "source", "methodology", "event_order"],
      "additionalProperties": true,
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "methodology": { "type": "string", "minLength": 1 },
        "event_order": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "note": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "event_id", "label", "start_date", "end_date", "fpi_net_flow",
        "dii_net_flow", "dii_offset_ratio", "nifty_max_drawdown", "recovery_days"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "fpi_net_flow": { "type": ["number", "null"] },
        "dii_net_flow": { "type": ["number", "null"] },
        "dii_offset_ratio": { "type": ["number", "null"], "minimum": 0 },
        "nifty_max_drawdown": { "type": ["number", "null"], "minimum": -1, "maximum": 0 },
        "currency_move": { "type": ["number", "null"] },
        "recovery_days": { "type": ["integer", "null"], "minimum": 0 },
        "note": { "type": "string" }
      }
    }
  }
}
