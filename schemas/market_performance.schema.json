{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/market_performance.schema.json",
  "title": "Market Performance Bundle",
  "description": "Market price series plus scalar risk/return statistics for India and global benchmarks.",
  "type": "object",
  "required": [
    "metadata",
    "markets"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "generated_at",
        "source",
        "start_date",
        "end_date",
        "base_value",
        "risk_free_rate"
      ],
      "additionalProperties": true,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "base_value": {
          "type": "number"
        },
        "risk_free_rate": {
          "type": "number"
        },
        "interval": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "markets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/market"
      }
    },
    "correlations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correlation"
      }
    }
  },
  "$defs": {
    "market": {
      "type": "object",
      "required": [
        "label",
        "ticker",
        "currency",
        "summary",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "summary": {
          "type": "object",
          "required": [
            "total_return",
            "cagr",
            "annualized_volatility",
            "sharpe_ratio",
            "max_drawdown"
          ],
          "additionalProperties": true,
          "properties": {
            "total_return": {
              "type": [
                "number",
                "null"
              ]
            },
            "cagr": {
              "type": [
                "number",
                "null"
              ]
            },
            "annualized_volatility": {
              "type": [
                "number",
                "null"
              ]
            },
            "sharpe_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_drawdown": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "price",
              "normalized_value"
            ],
            "additionalProperties": true,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "price": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "normalized_value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "return": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "drawdown": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rolling_volatility": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "correlation": {
      "type": "object",
      "required": [
        "market_a",
        "market_b",
        "correlation"
      ],
      "additionalProperties": false,
      "properties": {
        "market_a": {
          "type": "string"
        },
        "market_b": {
          "type": "string"
        },
        "correlation": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "window": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        }
      }
    }
  }
}
