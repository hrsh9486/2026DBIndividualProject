{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/static_frontend_indicator_manifest.schema.json",
  "title": "Static Frontend Indicator Manifest",
  "description": "Navigation, public-file references and presentation configuration for a React frontend. Every data_path points to a static JSON file served from the React application's public directory. Each referenced file validates against one of the existing annual-country, dated-multi-series or market-performance schemas.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "public_data_root",
    "assets",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "public_data_root": {
      "type": "string",
      "pattern": "^/",
      "description": "Browser-visible root for static data files, for example '/data'. The corresponding source directory is normally '<project>/public/data'."
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "data_path",
        "schema",
        "expected_frequency",
        "stale_after_days"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "enum": [
            "annual_country_series",
            "dated_multi_series",
            "market_performance"
          ]
        },
        "expected_frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annual",
            "mixed"
          ]
        },
        "stale_after_days": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": [
            "active",
            "partial",
            "planned"
          ],
          "default": "active"
        },
        "data_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+\\.json$",
          "description": "Absolute browser path to the static JSON asset, such as '/data/equities/market-performance.json'."
        },
        "schema_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+\\.json$",
          "description": "Optional browser path to the JSON Schema used for this asset. Build validation should still use the source-control copy."
        },
        "cache_strategy": {
          "type": "string",
          "enum": [
            "no-cache",
            "revalidate",
            "immutable"
          ],
          "default": "revalidate"
        },
        "version": {
          "type": "string",
          "description": "Optional pipeline build ID, date stamp or content hash."
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "label",
        "order",
        "indicators"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indicator"
          }
        }
      }
    },
    "indicator": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "default_view",
        "views"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "default_view": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/view"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "label",
        "asset_id",
        "presentation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": [
        "component",
        "chart_type",
        "x_axis",
        "default_visible",
        "controls",
        "show_source",
        "show_methodology"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "country-comparison-line",
            "multi-series-line",
            "market-performance"
          ]
        },
        "chart_type": {
          "const": "line"
        },
        "x_axis": {
          "type": "string",
          "enum": [
            "year",
            "date"
          ]
        },
        "market_field": {
          "type": "string",
          "enum": [
            "price",
            "normalized_value",
            "return",
            "drawdown",
            "rolling_volatility"
          ]
        },
        "default_visible": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "value_format": {
          "$ref": "#/$defs/valueFormat"
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seriesPresentation"
          }
        },
        "summary_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summaryField"
          }
        },
        "controls": {
          "$ref": "#/$defs/controls"
        },
        "zero_line": {
          "type": "boolean",
          "default": false
        },
        "show_status": {
          "type": "boolean",
          "default": false
        },
        "show_source": {
          "type": "boolean"
        },
        "show_methodology": {
          "type": "boolean"
        }
      }
    },
    "seriesPresentation": {
      "type": "object",
      "required": [
        "key",
        "axis",
        "visible"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label_override": {
          "type": "string"
        },
        "axis": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "format": {
          "$ref": "#/$defs/valueFormat"
        }
      }
    },
    "summaryField": {
      "type": "object",
      "required": [
        "key",
        "label",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/valueFormat"
        }
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "date_range",
        "entity_toggle",
        "series_toggle"
      ],
      "additionalProperties": false,
      "properties": {
        "date_range": {
          "type": "boolean"
        },
        "entity_toggle": {
          "type": "boolean"
        },
        "series_toggle": {
          "type": "boolean"
        }
      }
    },
    "valueFormat": {
      "type": "object",
      "required": [
        "style",
        "scale",
        "decimals"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "number",
            "percent",
            "currency",
            "ratio",
            "index",
            "months",
            "compact"
          ]
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      }
    }
  }
}